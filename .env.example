SRI_HEADLESS=true
SRI_BROWSER_BACKEND=camoufox
SRI_TIMEOUT_MS=60000
SRI_PROFILE_DIR=/app/storage/browser-profile
SRI_CHROME_PATH=
SRI_CHROME_PROFILE_DIR=storage/chrome-cdp-profile
SRI_CDP_PORT=9222
SRI_RATE_LIMIT_SECONDS=5
SRI_SCREENSHOT_DIR=/app/storage/screenshots
LOG_LEVEL=INFO

# Capsolver - genera tokens reCAPTCHA Enterprise v3 para el SRI.
# El SRI valida score >= 0.5; si responde "Puntaje bajo", el proveedor debe ajustar
# la configuracion del sitio/accion o usarse un flujo manual autorizado.
CAPSOLVER_API_KEY=
CAPSOLVER_LOG_TOKEN=false
CAPSOLVER_ANCHOR=
CAPSOLVER_RELOAD=

# 2captcha — alternativa con workers humanos (mejor score Enterprise que Capsolver ProxyLess)
# https://2captcha.com — si está configurada tiene prioridad sobre Capsolver
TWOCAPTCHA_API_KEY=
